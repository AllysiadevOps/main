APP_ENV=production
HOST=0.0.0.0
PORT=5050
CORS_ORIGINS=https://your-frontend.example
# Origins not on CORS_ORIGINS are rejected server-side with a 403
# FORBIDDEN_ORIGIN error before route handlers execute. Requests without an
# Origin header (health probes, scrapers, server-to-server calls) are unaffected.
# request body limits (per endpoint class).
# MAX_CONTENT_LENGTH must stay above MAX_VIDEO_BYTES — multipart envelope headers add a
# few hundred bytes per request, so leave at least ~20% headroom over the largest expected
# video upload. The global Werkzeug handler otherwise returns a generic 413 before the
# `/api/stego/*` and `/api/noir/*` route-level checks can produce a richer error message.
MAX_CONTENT_LENGTH=314572800    # absolute max for any request (300 MB; > MAX_VIDEO_BYTES)
MAX_VIDEO_BYTES=262144000       # max video file upload (250 MB)
MAX_JSON_BYTES=1048576          # max JSON request body (1 MB)
MAX_METADATA_BYTES=16384        # max metadata field / payload (16 KB)
# Streaming upload configuration - limits enforced at parser level before buffering
UPLOAD_MAX_BYTES=262144000      # max bytes per streaming upload (250 MB, matches MAX_VIDEO_BYTES)
UPLOAD_TEMP_DIR=/tmp/harpocrates-uploads  # directory for temporary upload files (defaults to system temp)
UPLOAD_TIMEOUT_SECONDS=300      # max seconds to complete upload before timeout (5 minutes)
UPLOAD_MAX_CONCURRENT=10        # max number of concurrent uploads in flight
SECURITY_HEADERS_ENABLED=true
# Per-client rate limits (flask-limiter syntax), keyed on the real client IP.
# TRUSTED_PROXIES is a comma-separated CIDR list; when empty no proxy is trusted
# and X-Forwarded-For is ignored, so limits cannot be bypassed by spoofing.
RATELIMIT_ENABLED=true
# Rate limit storage backend URI (defaults to memory://).
# In-memory storage is per-process and only suitable for single-worker deployments.
# Multi-worker deployments (e.g. gunicorn with multiple workers) should configure a
# shared backend such as Redis (e.g. redis://localhost:6379/0) to share limits across processes.
RATELIMIT_STORAGE_URI=memory://
TRUSTED_PROXIES=
RATELIMIT_EMBED=30 per minute
RATELIMIT_EXTRACT=30 per minute
RATELIMIT_SILENT_WITNESS=20 per minute
RATELIMIT_REGISTER=30 per minute
RATELIMIT_UPLOAD_SESSION=60 per minute
RATELIMIT_UPLOAD_CHUNK=240 per minute
EXPOSE_METADATA_HEADER=false
METRICS_ENABLED=true
METRICS_TOKEN=secret-scraping-token
METRICS_PATH=/metrics
# OpenTelemetry traces are opt-in. When enabled, configure a trusted collector
# endpoint; use OTEL_EXPORTER_OTLP_HEADERS via deployment secrets if required.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=harpocrates-backend
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_TRACES_SAMPLER_ARG=0.1
OTEL_EXPORT_TIMEOUT_SECONDS=5
NOIR_WORKER_ENABLED=false
NOIR_PROOF_TIMEOUT_SECONDS=180
HARPOCRATES_RELEASE_ID=harpocrates-1.0.0
HARPOCRATES_RELEASE_NETWORK=testnet
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Migration ledger integrity: abort startup when an applied migration's
# recorded SHA-256 checksum no longer matches its in-code definition.
# Use `warn` only as a temporary break-glass rollback while reconciling.
MIGRATION_CHECKSUM_ENFORCEMENT=enforce
# Neon connect retries (bounded). Never log DATABASE_URL / credentials.
DB_CONNECT_TIMEOUT_SECONDS=5      # per-attempt libpq connect timeout
DB_CONNECT_DEADLINE_SECONDS=15    # overall connect+retry budget
DB_CONNECT_MAX_ATTEMPTS=4         # max attempts within the deadline
DB_CONNECT_RETRY_BASE_SECONDS=0.05  # exponential backoff base

# External evidence fetch safety bounds
# EXTERNAL_FETCH_CONNECT_TIMEOUT_SECONDS — TCP+TLS connect phase limit (default 5 s)
# EXTERNAL_FETCH_READ_TIMEOUT_SECONDS    — per-recv read phase limit (default 10 s)
# EXTERNAL_FETCH_MAX_RESPONSE_BYTES      — response body hard cap (default 65536 = 64 KiB)
EXTERNAL_FETCH_CONNECT_TIMEOUT_SECONDS=5.0
EXTERNAL_FETCH_READ_TIMEOUT_SECONDS=10.0
EXTERNAL_FETCH_MAX_RESPONSE_BYTES=65536

# Proof-registration credential rotation. Keep the primary key in
# REGISTER_API_KEY and set REGISTER_API_KEY_PREVIOUS during a rotation. Both
# keys are accepted until the previous key's optional expiry, so clients can
# migrate without downtime. Never commit real values to this file.
REGISTER_API_KEY=
REGISTER_API_KEY_EXPIRES=
REGISTER_API_KEY_PREVIOUS=
REGISTER_API_KEY_PREVIOUS_EXPIRES=
# Owner-scoped keys: comma-separated <G-address>:<sha256-hex-of-token> entries.
# A scoped key may only register proofs whose sourceAddress is its own address,
# and cannot register a proof another address already owns. Store the digest,
# never the token:  printf %s "$TOKEN" | sha256sum
# REGISTER_SCOPED_KEYS=GABC...:0123abcd...64hex

# Proof event retention worker
# HARPOCRATES_RETENTION_BATCH_SIZE controls how many proof events the retention
# worker deletes per batch (clamped to 1..5000; defaults to 100).
HARPOCRATES_RETENTION_BATCH_SIZE=100
